  <Sequence DisplayName="Orchestrator Exploration" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:InvokeCode Code="Dim projectRoot As String = System.Environment.CurrentDirectory
Dim dataDir As String = System.IO.Path.Combine(projectRoot, &quot;Data&quot;)
If Not System.IO.Directory.Exists(dataDir) Then
    projectRoot = System.AppDomain.CurrentDomain.BaseDirectory
    dataDir = System.IO.Path.Combine(projectRoot, &quot;Data&quot;)
End If
If Not System.IO.Directory.Exists(dataDir) Then
    Throw New System.IO.DirectoryNotFoundException(&quot;Open this project in UiPath Studio and run it from its project folder so the Data folder can be found.&quot;)
End If
Dim outputDir As String = System.IO.Path.Combine(projectRoot, &quot;Output&quot;)
System.IO.Directory.CreateDirectory(outputDir)
Dim checklist As String = &quot;UIPATH ORCHESTRATOR LAB CHECKLIST&quot; &amp; vbCrLf &amp; vbCrLf &amp; &quot;1. Sign in to the lab Automation Cloud tenant.&quot; &amp; vbCrLf &amp; &quot;2. Open the permitted folder and inspect Processes, Jobs, Queues, Assets and Monitoring.&quot; &amp; vbCrLf &amp; &quot;3. Publish a simple process from Studio to the approved feed.&quot; &amp; vbCrLf &amp; &quot;4. Create/inspect the process in the correct Orchestrator folder.&quot; &amp; vbCrLf &amp; &quot;5. Confirm robot or machine availability before starting a job.&quot; &amp; vbCrLf &amp; &quot;6. Run a test job and inspect Successful, Faulted or Running status.&quot; &amp; vbCrLf &amp; &quot;7. If enabled, create an approved schedule.&quot; &amp; vbCrLf &amp; &quot;8. Review job logs and record any error details.&quot; &amp; vbCrLf &amp; vbCrLf &amp; &quot;This local file is a checklist. Actual Orchestrator actions require the institution tenant and permissions.&quot;
System.IO.File.WriteAllText(System.IO.Path.Combine(outputDir, &quot;Orchestrator_Lab_Checklist.txt&quot;), checklist, New System.Text.UTF8Encoding(True))" Language="VBNet" DisplayName="Run local demo" sap2010:WorkflowViewState.IdRef="InvokeCode_1" />
