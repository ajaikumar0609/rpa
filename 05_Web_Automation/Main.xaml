  <Sequence DisplayName="Browser Interaction" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:InvokeCode Code="Dim projectRoot As String = System.Environment.CurrentDirectory
Dim dataDir As String = System.IO.Path.Combine(projectRoot, &quot;Data&quot;)
If Not System.IO.Directory.Exists(dataDir) Then
    projectRoot = System.AppDomain.CurrentDomain.BaseDirectory
    dataDir = System.IO.Path.Combine(projectRoot, &quot;Data&quot;)
End If
If Not System.IO.Directory.Exists(dataDir) Then
    Throw New System.IO.DirectoryNotFoundException(&quot;Open this project in UiPath Studio and run it from its project folder so the Data folder can be found.&quot;)
End If
Dim outputDir As String = System.IO.Path.Combine(projectRoot, &quot;Output&quot;)
System.IO.Directory.CreateDirectory(outputDir)
Dim searchUrl As String = &quot;https://www.google.com/search?q=UiPath+RPA+automation&quot;
Dim logPath As String = System.IO.Path.Combine(outputDir, &quot;browser_automation_demo.txt&quot;)
System.IO.File.WriteAllText(logPath, &quot;Search URL opened: &quot; &amp; searchUrl &amp; System.Environment.NewLine &amp; &quot;Lab activity map: Use Application/Browser -&gt; Type Into -&gt; Click -&gt; Get Text.&quot;, New System.Text.UTF8Encoding(True))
System.Diagnostics.Process.Start(New System.Diagnostics.ProcessStartInfo(searchUrl) With {.UseShellExecute = True})" Language="VBNet" DisplayName="Run local demo" sap2010:WorkflowViewState.IdRef="InvokeCode_1" />
    <ui:MessageBox Caption="RPA Lab Demo" DisplayName="Show completion message" Text="[&quot;Default browser opened with a UiPath search query. For the full selector-based workflow, indicate the search box and button in UiPath Studio.&quot;]" sap2010:WorkflowViewState.IdRef="MessageBox_1" />
