  <Sequence DisplayName="Image-Based Interaction" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:InvokeCode Code="Dim projectRoot As String = System.Environment.CurrentDirectory
Dim dataDir As String = System.IO.Path.Combine(projectRoot, &quot;Data&quot;)
If Not System.IO.Directory.Exists(dataDir) Then
    projectRoot = System.AppDomain.CurrentDomain.BaseDirectory
    dataDir = System.IO.Path.Combine(projectRoot, &quot;Data&quot;)
End If
If Not System.IO.Directory.Exists(dataDir) Then
    Throw New System.IO.DirectoryNotFoundException(&quot;Open this project in UiPath Studio and run it from its project folder so the Data folder can be found.&quot;)
End If
Dim outputDir As String = System.IO.Path.Combine(projectRoot, &quot;Output&quot;)
System.IO.Directory.CreateDirectory(outputDir)
Dim targetFile As String = System.IO.Path.Combine(dataDir, &quot;image_target_demo.html&quot;)
Dim targetUrl As String = New System.Uri(targetFile).AbsoluteUri
System.IO.File.WriteAllText(System.IO.Path.Combine(outputDir, &quot;image_recognition_steps.txt&quot;), &quot;1. Run this workflow to open the sample target page.&quot; &amp; vbCrLf &amp; &quot;2. In UiPath Studio, use Find Image and indicate the blue TARGET button.&quot; &amp; vbCrLf &amp; &quot;3. Add Click Image after Find Image, set a timeout, then verify with a Message Box.&quot; &amp; vbCrLf &amp; &quot;4. Keep display scaling/resolution unchanged during the test.&quot;, New System.Text.UTF8Encoding(True))
System.Diagnostics.Process.Start(New System.Diagnostics.ProcessStartInfo(targetUrl) With {.UseShellExecute = True})" Language="VBNet" DisplayName="Run local demo" sap2010:WorkflowViewState.IdRef="InvokeCode_1" />
    <ui:MessageBox Caption="RPA Lab Demo" DisplayName="Show completion message" Text="[&quot;Sample image target page opened. Add Find Image/Click Image with a target captured on your computer.&quot;]" sap2010:WorkflowViewState.IdRef="MessageBox_1" />
